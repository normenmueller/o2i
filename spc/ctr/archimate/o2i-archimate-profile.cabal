cabal-version: 3.0

name: o2i-archimate-profile
version: 0.2.0.0
synopsis: Executable ArchiMate profile contract for O2I.
category: Formal Methods, Modelling
description:
  O2I ArchiMate Profile provides the closed typed projection of the
  authoritative declarative ArchiMate mapping contract. Notation adapters
  consume the projection without owning duplicate mapping registries.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
data-files:
  profile.json
extra-source-files:
  profile.md

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.ArchiMate.Profile
  other-modules:
    O2I.ArchiMate.Profile.Internal
  build-depends:
    base >=4.18 && <4.19,
    o2i-core ==0.2.0.0,
    o2i-inspection ==0.2.0.0,
    text >=2.0 && <2.1
  hs-source-dirs:
    src

test-suite o2i-archimate-profile-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.ArchiMate.Profile.Internal,
    O2I.ArchiMate.Profile.Test.Contract,
    Paths_o2i_archimate_profile
  autogen-modules:
    Paths_o2i_archimate_profile
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <4.19,
    bytestring >=0.11 && <0.12,
    o2i-core ==0.2.0.0,
    o2i-inspection ==0.2.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.1
  hs-source-dirs:
    tst,
    src

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
