cabal-version: 3.0

name: o2i-archimate-profile
version: 0.3.0.0
synopsis: Executable ArchiMate profile contract for O2I.
category: Formal Methods, Modelling
description:
  O2I ArchiMate Profile provides the closed typed projection of the
  authoritative declarative ArchiMate mapping contract. Notation adapters
  consume the projection without owning duplicate mapping registries.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
data-files:
  profile.json
extra-source-files:
  contract/compile.py,
  contract/test_compile.py,
  tst/api/compile-pass/*.hs,
  tst/api/compile-fail/*.hs

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.ArchiMate.Profile,
    O2I.ArchiMate.Profile.Closure,
    O2I.ArchiMate.Profile.Draft,
    O2I.ArchiMate.Profile.Mapping,
    O2I.ArchiMate.Profile.Notation,
    O2I.ArchiMate.Profile.Projection,
    O2I.ArchiMate.Profile.Resolution,
    O2I.ArchiMate.Profile.Rule.Catalog,
    O2I.ArchiMate.Profile.Rule.Explanation
  other-modules:
    O2I.ArchiMate.Profile.Internal.Closure,
    O2I.ArchiMate.Profile.Internal.Closure.Witness,
    O2I.ArchiMate.Profile.Internal.Draft,
    O2I.ArchiMate.Profile.Internal.Generated,
    O2I.ArchiMate.Profile.Internal.Index,
    O2I.ArchiMate.Profile.Internal.Mapping,
    O2I.ArchiMate.Profile.Internal.Notation,
    O2I.ArchiMate.Profile.Internal.Notation.Conformance,
    O2I.ArchiMate.Profile.Internal.Notation.Witness,
    O2I.ArchiMate.Profile.Internal.Projection,
    O2I.ArchiMate.Profile.Internal.Resolution,
    O2I.ArchiMate.Profile.Rule.Internal.Catalog,
    O2I.ArchiMate.Profile.Rule.Internal.Definition,
    O2I.ArchiMate.Profile.Rule.Internal.Explanation
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.7 && <0.8,
    o2i-core ==0.2.0.0,
    text >=2.1 && <2.2,
    unicode-transforms ==0.4.0.1
  hs-source-dirs:
    src

-- Build-only public-source owner conformance.  The production library has no
-- dependency on this component.
library conformance
  import:
    warnings,
    language
  visibility: public
  exposed-modules:
    O2I.ArchiMate.Profile.Conformance,
    O2I.ArchiMate.Profile.Conformance.Source
  build-depends:
    base >=4.20 && <4.21,
    o2i-archimate-profile,
    text >=2.1 && <2.2
  hs-source-dirs:
    conformance

test-suite o2i-archimate-profile-conformance-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.7 && <0.8,
    o2i-archimate-profile,
    o2i-archimate-profile:conformance,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11
  hs-source-dirs:
    conformance-test

test-suite o2i-archimate-profile-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.ArchiMate.Profile.Test.Contract,
    Paths_o2i_archimate_profile
  autogen-modules:
    Paths_o2i_archimate_profile
  build-depends:
    base >=4.20 && <4.21,
    o2i-archimate-profile,
    o2i-archimate-profile:conformance,
    o2i-core ==0.2.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2
  hs-source-dirs: tst

test-suite o2i-archimate-profile-internal-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.ArchiMate.Profile,
    O2I.ArchiMate.Profile.Closure,
    O2I.ArchiMate.Profile.Draft,
    O2I.ArchiMate.Profile.Mapping,
    O2I.ArchiMate.Profile.Notation,
    O2I.ArchiMate.Profile.Projection,
    O2I.ArchiMate.Profile.Resolution,
    O2I.ArchiMate.Profile.Rule.Catalog,
    O2I.ArchiMate.Profile.Rule.Explanation,
    O2I.ArchiMate.Profile.Internal.Closure,
    O2I.ArchiMate.Profile.Internal.Closure.Witness,
    O2I.ArchiMate.Profile.Internal.ClosureWorkTest,
    O2I.ArchiMate.Profile.Internal.Draft,
    O2I.ArchiMate.Profile.Internal.Fixture,
    O2I.ArchiMate.Profile.Internal.Generated,
    O2I.ArchiMate.Profile.Internal.Index,
    O2I.ArchiMate.Profile.Internal.InventoryTest,
    O2I.ArchiMate.Profile.Internal.Mapping,
    O2I.ArchiMate.Profile.Internal.Notation,
    O2I.ArchiMate.Profile.Internal.Notation.Conformance,
    O2I.ArchiMate.Profile.Internal.NotationConformanceTest,
    O2I.ArchiMate.Profile.Internal.Notation.Witness,
    O2I.ArchiMate.Profile.Internal.Projection,
    O2I.ArchiMate.Profile.Internal.Resolution,
    O2I.ArchiMate.Profile.Rule.CatalogTest,
    O2I.ArchiMate.Profile.Rule.Internal.Catalog,
    O2I.ArchiMate.Profile.Rule.Internal.Definition,
    O2I.ArchiMate.Profile.Rule.Internal.Explanation,
    O2I.ArchiMate.Profile.Conformance.Source
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.7 && <0.8,
    o2i-core ==0.2.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2,
    unicode-transforms ==0.4.0.1
  hs-source-dirs:
    tst/internal,
    conformance,
    src

test-suite o2i-archimate-profile-api-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ApiContractTH
  build-depends:
    base >=4.20 && <4.21,
    o2i-archimate-profile,
    o2i-archimate-profile:conformance,
    template-haskell >=2.22 && <2.23
  hs-source-dirs:
    tst/api

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
