cabal-version: 3.0

name: o2i-cli
version: 0.3.0.0
synopsis: Deterministic command-line operations for O2I models.
category: Formal Methods, Modelling
description:
  The O2I CLI composes a validated static adapter collection with the public
  Operation capabilities, preserves their canonical machine documents, and
  owns only parsing, terminal-safe human rendering, streams, and exits.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
data-files:
  tst/fixtures/assessment-input.json
  tst/fixtures/profiled-minimal.archimate
  tst/fixtures/readiness-input.json
  tst/golden/adapters-human.txt
  tst/golden/adapters-json.json
  tst/golden/help.txt
  tst/golden/profiles-human.txt
  tst/golden/profiles-json.json

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library o2i-cli-internal
  import:
    warnings,
    language
  visibility: private
  exposed-modules:
    O2I.Cli,
    O2I.Cli.Command,
    O2I.Cli.Human,
    O2I.Cli.Input,
    O2I.Cli.Options,
    O2I.Cli.Output,
    O2I.Cli.Scanner,
    O2I.Cli.Static,
    O2I.Cli.TerminalText
  autogen-modules:
    Paths_o2i_cli
  other-modules:
    Paths_o2i_cli
  build-depends:
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    o2i-amx ==0.3.0.0,
    o2i-operation ==0.3.0.0,
    text >=2.1 && <2.2
  hs-source-dirs:
    src/lib

executable o2i
  import:
    warnings,
    language
  main-is: Main.hs
  build-depends:
    base >=4.20 && <4.21,
    o2i-cli:o2i-cli-internal
  hs-source-dirs:
    src/app

test-suite o2i-cli-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.Cli.Test.Options,
    O2I.Cli.Test.Output,
    O2I.Cli.Test.Process,
    O2I.Cli.Test.Scanner,
    O2I.Cli.Test.Static,
    O2I.Cli.Test.Support,
    O2I.Cli.Test.TerminalText,
    Paths_o2i_cli
  autogen-modules:
    Paths_o2i_cli
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    jsonschema ==0.2.0.0,
    o2i-cli:o2i-cli-internal,
    o2i-operation ==0.3.0.0,
    process >=1.6 && <1.7,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2
  build-tool-depends:
    o2i-cli:o2i
  hs-source-dirs:
    tst

test-suite o2i-cli-api-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ApiContractTH,
    PublicComposition
  build-depends:
    base >=4.20 && <4.21,
    o2i-cli:o2i-cli-internal,
    o2i-operation ==0.3.0.0,
    template-haskell >=2.22 && <2.23
  hs-source-dirs:
    tst/api

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
