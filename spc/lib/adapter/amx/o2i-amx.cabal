cabal-version: 3.0

name: o2i-amx
version: 0.2.0.0
synopsis: Native Archi Model XML adapter for O2I inspection.
category: Formal Methods, Modelling
description:
  O2I AMX safely decodes native Archi Model XML, resolves one exact View, and
  projects persisted O2I profile facts with occurrence-level provenance into
  the format-neutral O2I inspection contract.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
extra-source-files:
  tst/data/README.md
  tst/data/manifest.json
  tst/data/valid/catalog.json
  tst/data/valid/README.md
  tst/data/valid/native/minimal.archimate
  tst/data/valid/orientation/ethos.archimate
  tst/data/invalid/decode/*.archimate
  tst/data/invalid/view/*.archimate
  tst/data/invalid/profile/*.archimate

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.Adapter.AMX
  other-modules:
    O2I.Adapter.AMX.Internal.Defect,
    O2I.Adapter.AMX.Internal.Profile,
    O2I.Adapter.AMX.Internal.Profile.Closure,
    O2I.Adapter.AMX.Internal.Profile.Collective,
    O2I.Adapter.AMX.Internal.Profile.Collective.Index,
    O2I.Adapter.AMX.Internal.Profile.Collective.Syntax,
    O2I.Adapter.AMX.Internal.Profile.Commitment,
    O2I.Adapter.AMX.Internal.Profile.Metadata,
    O2I.Adapter.AMX.Internal.Profile.Model,
    O2I.Adapter.AMX.Internal.Profile.Property,
    O2I.Adapter.AMX.Internal.Profile.Projection,
    O2I.Adapter.AMX.Internal.Registry,
    O2I.Adapter.AMX.Internal.Types,
    O2I.Adapter.AMX.Internal.View,
    O2I.Adapter.AMX.Internal.XML,
    O2I.Adapter.AMX.Internal.XML.Scan
  build-depends:
    base >=4.18 && <4.19,
    bytestring >=0.11 && <0.12,
    containers >=0.6 && <0.7,
    o2i-archimate-profile ==0.2.0.0,
    o2i-core ==0.2.0.0,
    o2i-inspection ==0.2.0.0,
    text >=2.0 && <2.1,
    xml-conduit >=1.10 && <1.11
  hs-source-dirs:
    src

test-suite o2i-amx-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.Adapter.AMX,
    O2I.Adapter.AMX.Internal.Defect,
    O2I.Adapter.AMX.Internal.Profile,
    O2I.Adapter.AMX.Internal.Profile.Closure,
    O2I.Adapter.AMX.Internal.Profile.Collective,
    O2I.Adapter.AMX.Internal.Profile.Collective.Index,
    O2I.Adapter.AMX.Internal.Profile.Collective.Syntax,
    O2I.Adapter.AMX.Internal.Profile.Commitment,
    O2I.Adapter.AMX.Internal.Profile.Metadata,
    O2I.Adapter.AMX.Internal.Profile.Model,
    O2I.Adapter.AMX.Internal.Profile.Property,
    O2I.Adapter.AMX.Internal.Profile.Projection,
    O2I.Adapter.AMX.Internal.Registry,
    O2I.Adapter.AMX.Internal.Types,
    O2I.Adapter.AMX.Internal.View,
    O2I.Adapter.AMX.Internal.XML,
    O2I.Adapter.AMX.Internal.XML.Scan,
    O2I.Adapter.AMX.Test.Decode,
    O2I.Adapter.AMX.Test.Collective,
    O2I.Adapter.AMX.Test.Collective.Contract,
    O2I.Adapter.AMX.Test.Collective.Evidence,
    O2I.Adapter.AMX.Test.Collective.Evidence.Scenario,
    O2I.Adapter.AMX.Test.Collective.Fixture,
    O2I.Adapter.AMX.Test.Collective.Index,
    O2I.Adapter.AMX.Test.Collective.Scenario,
    O2I.Adapter.AMX.Test.Commitment,
    O2I.Adapter.AMX.Test.Fixture,
    O2I.Adapter.AMX.Test.Profile,
    O2I.Adapter.AMX.Test.Projection,
    O2I.Adapter.AMX.Test.Support,
    O2I.Adapter.AMX.Test.View
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <4.19,
    bytestring >=0.11 && <0.12,
    containers >=0.6 && <0.7,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    o2i-archimate-profile ==0.2.0.0,
    o2i-core ==0.2.0.0,
    o2i-inspection ==0.2.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.1,
    xml-conduit >=1.10 && <1.11
  hs-source-dirs:
    tst,
    src

test-suite o2i-amx-api-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ApiContractTH
  build-depends:
    base >=4.18 && <4.19,
    o2i-amx,
    o2i-inspection ==0.2.0.0,
    template-haskell >=2.20 && <2.21
  hs-source-dirs:
    tst/api

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
