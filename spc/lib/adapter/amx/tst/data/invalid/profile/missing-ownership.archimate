<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="5.0.0">
  <folder>
    <element xsi:type="archimate:Driver" id="driver">
      <property key="o2i.kind" value="Primitive"/>
      <property key="o2i.type" value="Driver"/>
      <property key="o2i.commitment" value="asserted"/>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="view" name="Scope">
      <child xsi:type="archimate:DiagramObject" id="object" archimateElement="driver"/>
    </element>
  </folder>
  <property key="o2i.profile" value="0.2"/>
</archimate:model>
