cabal-version: 3.0

name: o2i-core
version: 0.2.0.0
synopsis: Typed validation core for the O2I metamodel.
category: Formal Methods, Modelling
description:
  O2I provides a compact Haskell library for the typed semantic core and
  validation rules of the Orientation to Impact metamodel.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
extra-source-files:
  contract/compile.py
  contract/generated/o2i.core.owner-diagnostic-evidence-v1.json
  contract/generated/o2i.core.semantic-diagnostic-evidence-v1.json
  contract/test_compile.py
  semantic-diagnostic-evidence.json
  semantics.json
  tst/api/compile-pass/*.hs
  tst/api/compile-fail/*.hs
  tst/internal/compile-fail/*.hs
common warnings
  ghc-options:
    -Wall

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.Core.Contract,
    O2I.Core.Graph.Observation,
    O2I.Core.Identity,
    O2I.Core.Rule.Catalog,
    O2I.Semantics,
    O2I.Semantics.Input,
    O2I.Structure,
    O2I.Trace
  other-modules:
    O2I.Core.Contract.Generated,
    O2I.Core.Contract.Internal,
    O2I.Core.Graph.Commitment,
    O2I.Core.Graph.Observation.Index,
    O2I.Core.Graph.Observation.Internal,
    O2I.Core.Identity.Internal,
    O2I.Core.Rule.Catalog.Definition,
    O2I.Core.Rule.Catalog.Definition.CapabilityInput,
    O2I.Core.Rule.Catalog.Definition.Qualification,
    O2I.Core.Rule.Catalog.Definition.ReadinessAndAssessment,
    O2I.Core.Rule.Catalog.Definition.Semantics,
    O2I.Core.Rule.Catalog.Definition.Structure,
    O2I.Core.Rule.Catalog.Definition.Trace,
    O2I.Core.Rule.Catalog.Internal,
    O2I.Input.Internal.Binding,
    O2I.Input.Internal.Decode,
    O2I.Input.Internal.Json,
    O2I.Input.Internal.Set,
    O2I.Input.Internal.Text,
    O2I.Input.Internal.Types,
    O2I.Semantics.Contextualization,
    O2I.Semantics.Eval,
    O2I.Semantics.Index,
    O2I.Semantics.Family.CollectiveStrategyRealization,
    O2I.Semantics.Internal,
    O2I.Semantics.SituatedNeed,
    O2I.Semantics.Strategy,
    O2I.Semantics.Vocabulary,
    O2I.Structure.Index,
    O2I.Structure.Internal,
    O2I.Structure.Proposition,
    O2I.Trace.Eval,
    O2I.Trace.Grammar,
    O2I.Trace.Index,
    O2I.Trace.Internal
  build-depends:
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    text >=2.1 && <2.2,
    unicode-transforms ==0.4.0.1
  hs-source-dirs:
    src

library conformance
  import:
    warnings,
    language
  visibility: public
  exposed-modules:
    O2I.Core.Conformance
  other-modules:
    O2I.Core.Conformance.SemanticsSource
  build-depends:
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    o2i-core,
    text >=2.1 && <2.2
  hs-source-dirs:
    conformance

test-suite o2i-core-conformance-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.7 && <0.8,
    o2i-core,
    o2i-core:conformance,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11
  hs-source-dirs:
    conformance-test

-- This component compiles the profile-neutral identity boundary directly. It
-- verifies exact identity decoding, deterministic indexing, and nominal
-- selected-View scope without exporting internal resolution machinery.
test-suite o2i-identity-internal-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    IdentityMain.hs
  other-modules:
    O2I.Core.Contract,
    O2I.Core.Contract.Generated,
    O2I.Core.Contract.Internal,
    O2I.Core.Graph.Commitment,
    O2I.Core.Graph.Observation,
    O2I.Core.Graph.Observation.Internal,
    O2I.Core.Identity,
    O2I.Core.Identity.Internal
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.7 && <0.8,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2
  hs-source-dirs:
    tst/internal,
    src

-- This component proves that public semantic companion values are exact,
-- opaque wrappers over the generated closed catalogs.
test-suite o2i-contract-internal-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    O2I/Core/ContractTest.hs
  other-modules:
    O2I.Core.Contract,
    O2I.Core.Contract.Generated,
    O2I.Core.Contract.Internal
  build-depends:
    base >=4.20 && <4.21,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2
  hs-source-dirs:
    tst/internal,
    src

