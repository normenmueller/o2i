cabal-version: 3.0

name: o2i-core
version: 0.2.0.0
synopsis: Typed validation core for the O2I metamodel.
category: Formal Methods, Modelling
description:
  O2I provides a compact Haskell library for the typed semantic core and
  validation rules of the Orientation to Impact metamodel.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
extra-source-files:
  contract/compile.py
  contract/test_compile.py
  semantics.json
  tst/api/compile-pass/*.hs
  tst/api/compile-fail/*.hs
  tst/internal/compile-pass/*.hs
  tst/internal/compile-fail/*.hs
common warnings
  ghc-options:
    -Wall

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I,
    O2I.Core.Contract,
    O2I.Core.Graph.Observation,
    O2I.Core.Identity,
    O2I.Core.Rule.Catalog,
    O2I.Semantics,
    O2I.Semantics.Input,
    O2I.Structure,
    O2I.Graph,
    O2I.Language,
    O2I.Validation
  other-modules:
    O2I.Core.Contract.Generated,
    O2I.Core.Contract.Internal,
    O2I.Core.Graph.Commitment,
    O2I.Core.Graph.Observation.Index,
    O2I.Core.Graph.Observation.Internal,
    O2I.Core.Identity.Internal,
    O2I.Core.Rule.Catalog.Definition,
    O2I.Core.Rule.Catalog.Definition.CapabilityInput,
    O2I.Core.Rule.Catalog.Definition.Qualification,
    O2I.Core.Rule.Catalog.Definition.ReadinessAndAssessment,
    O2I.Core.Rule.Catalog.Definition.Semantics,
    O2I.Core.Rule.Catalog.Definition.Structure,
    O2I.Core.Rule.Catalog.Definition.Trace,
    O2I.Core.Rule.Catalog.Internal,
    O2I.Input.Internal.Binding,
    O2I.Input.Internal.Decode,
    O2I.Input.Internal.Json,
    O2I.Input.Internal.Set,
    O2I.Input.Internal.Text,
    O2I.Input.Internal.Types,
    O2I.Semantics.Contextualization,
    O2I.Semantics.Eval,
    O2I.Semantics.Index,
    O2I.Semantics.Family.CollectiveStrategyRealization,
    O2I.Semantics.Internal,
    O2I.Semantics.SituatedNeed,
    O2I.Semantics.Strategy,
    O2I.Semantics.Vocabulary,
    O2I.Structure.Index,
    O2I.Structure.Internal,
    O2I.Structure.Proposition,
    O2I.Graph.Macro,
    O2I.Graph.Macro.Index,
    O2I.Graph.Raw,
    O2I.Graph.Typed,
    O2I.Language.Claim,
    O2I.Language.Element,
    O2I.Language.Interpretation,
    O2I.Language.Macro,
    O2I.Language.Macro.Alternative,
    O2I.Language.Relation,
    O2I.Validation.Collective,
    O2I.Validation.Collective.Contribution,
    O2I.Validation.Collective.Contribution.Eval,
    O2I.Validation.Collective.Contribution.Index,
    O2I.Validation.Collective.Contribution.Types,
    O2I.Validation.Collective.FanIn,
    O2I.Validation.Collective.Fit,
    O2I.Validation.Collective.Registry,
    O2I.Validation.Collective.Registry.Internal,
    O2I.Validation.Collective.Types,
    O2I.Validation.Evidence,
    O2I.Validation.MacroEvidence,
    O2I.Validation.MacroEvidence.Eval,
    O2I.Validation.MacroEvidence.Prepare,
    O2I.Validation.MacroEvidence.Types,
    O2I.Validation.Qualification,
    O2I.Validation.Readiness,
    O2I.Validation.Relational.Eval,
    O2I.Validation.Relational.Index,
    O2I.Validation.Relational.Internal,
    O2I.Validation.Relational.Types,
    O2I.Validation.Semantics,
    O2I.Validation.Semantics.Context,
    O2I.Validation.Semantics.Context.TradeOffSet,
    O2I.Validation.Structure,
    O2I.Validation.Structure.Internal,
    O2I.Validation.Trace,
    O2I.Validation.Trace.Eval,
    O2I.Validation.Trace.Rule,
    O2I.Validation.Trace.Types
  build-depends:
    aeson >=2.2.5 && <2.3,
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    dependent-map >=0.4.0 && <0.5,
    dependent-sum >=0.7.1 && <0.8,
    text >=2.1 && <2.2,
    time >=1.12 && <1.13,
    unicode-transforms ==0.4.0.1,
    validation >=1.1 && <1.2
  hs-source-dirs:
    src

test-suite o2i-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  other-modules:
    O2I.Test.Collective,
    O2I.Test.Qualification,
    O2I.Test.Support
  build-depends:
    base >=4.20 && <4.21,
    o2i-core,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
    QuickCheck >=2.16 && <2.18,
    text >=2.1 && <2.2,
    time >=1.12 && <1.13,
    validation >=1.1 && <1.2
  hs-source-dirs:
    tst

