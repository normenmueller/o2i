cabal-version: 3.0

name: o2i-core
version: 0.2.0.0
synopsis: Typed validation core for the O2I metamodel.
category: Formal Methods, Modelling
description:
  O2I provides a compact Haskell library for the typed semantic core and
  validation rules of the Orientation to Impact metamodel.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
extra-source-files:
  tst/api/compile-pass/*.hs
  tst/api/compile-fail/*.hs
common warnings
  ghc-options:
    -Wall

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I,
    O2I.Graph,
    O2I.Language,
    O2I.Validation
  other-modules:
    O2I.Graph.Macro,
    O2I.Graph.Macro.Index,
    O2I.Graph.Raw,
    O2I.Graph.Typed,
    O2I.Language.Claim,
    O2I.Language.Element,
    O2I.Language.Interpretation,
    O2I.Language.Macro,
    O2I.Language.Relation,
    O2I.Validation.Collective,
    O2I.Validation.Collective.Fit,
    O2I.Validation.Collective.Types,
    O2I.Validation.Evidence,
    O2I.Validation.Qualification,
    O2I.Validation.Readiness,
    O2I.Validation.Semantics,
    O2I.Validation.Semantics.Context,
    O2I.Validation.Semantics.Context.TradeOffSet,
    O2I.Validation.Structure,
    O2I.Validation.Structure.Internal,
    O2I.Validation.Trace,
    O2I.Validation.Trace.Evidence
  build-depends:
    base >=4.18 && <4.19,
    containers >=0.6 && <0.7,
    text >=2.0 && <2.1,
    time >=1.12 && <1.13,
    validation >=1.1 && <1.2
  hs-source-dirs:
    src

test-suite o2i-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  other-modules:
    O2I.Test.Collective,
    O2I.Test.Qualification,
    O2I.Test.Support
  build-depends:
    base >=4.18 && <4.19,
    o2i-core,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
    QuickCheck >=2.16 && <2.18,
    text >=2.0 && <2.1,
    time >=1.12 && <1.13,
    validation >=1.1 && <1.2
  hs-source-dirs:
    tst

-- This component compiles the private macro-index modules directly. It keeps
-- deterministic lookup-work accounting testable without exporting
-- instrumentation from the public library.
test-suite o2i-macro-index-internal-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    MacroIndexMain.hs
  other-modules:
    O2I.Graph.Macro,
    O2I.Graph.Macro.Index,
    O2I.Graph.Raw,
    O2I.Language.Claim,
    O2I.Language.Element,
    O2I.Language.Macro,
    O2I.Language.Relation
  build-depends:
    base >=4.18 && <4.19,
    containers >=0.6 && <0.7,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
    QuickCheck >=2.16 && <2.18,
    text >=2.0 && <2.1
  hs-source-dirs:
    tst/internal,
    src

-- This component compiles the private collective-Fit index directly. It keeps
-- deterministic lookup-work accounting outside the public validation API.
test-suite o2i-collective-fit-internal-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    CollectiveFitMain.hs
  other-modules:
    O2I.Language.Element,
    O2I.Validation.Collective.Fit,
    O2I.Validation.Collective.Types,
    O2I.Validation.Semantics.Context.TradeOffSet
  build-depends:
    base >=4.18 && <4.19,
    containers >=0.6 && <0.7,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
    QuickCheck >=2.16 && <2.18,
    text >=2.0 && <2.1
  hs-source-dirs:
    tst/internal,
    src

test-suite o2i-language-api-test
  import:
    warnings,
    language
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  other-modules:
    ApiContractTH
  build-depends:
    base >=4.18 && <4.19,
    o2i-core,
    template-haskell >=2.20 && <2.21
  hs-source-dirs:
    tst/api

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
