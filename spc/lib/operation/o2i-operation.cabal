cabal-version: 3.0

name: o2i-operation
version: 0.3.0.0
synopsis: Capability-sized execution kernel for O2I models.
category: Formal Methods, Modelling
description:
  O2I Operation owns deterministic acquisition, static adapter composition,
  request preparation, provenance, discovery, and canonical machine results.
  It coordinates Core and immutable ArchiMate Profile contracts without
  redefining their semantics.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
extra-source-files:
  contract/compile.py,
  contract/operation.json,
  contract/schema/*.json,
  contract/test_compile.py,
  tst/api/compile-pass/*.hs,
  tst/api/compile-fail/*.hs,
  tst/fixtures/*.amx,
  tst/fixtures/*.json

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.Operation.Acquisition,
    O2I.Operation.Adapter,
    O2I.Operation.Adapter.Authoring,
    O2I.Operation.Discovery.Adapter,
    O2I.Operation.Discovery.Adapter.Machine,
    O2I.Operation.Discovery.Profile,
    O2I.Operation.Discovery.Profile.Machine,
    O2I.Operation.Discovery.Rule,
    O2I.Operation.Discovery.Rule.Explanation.Machine,
    O2I.Operation.Discovery.Rule.Inventory.Machine,
    O2I.Operation.Discovery.View,
    O2I.Operation.Discovery.View.Machine,
    O2I.Operation.Diagnostic,
    O2I.Operation.Diagnostic.Owner,
    O2I.Operation.Diagnostic.Owner.Source,
    O2I.Operation.Failure,
    O2I.Operation.Machine,
    O2I.Operation.Preparation,
    O2I.Operation.Profile,
    O2I.Operation.Provenance,
    O2I.Operation.Request,
    O2I.Operation.Rule.Catalog,
    O2I.Operation.Schema,
    O2I.Operation.View
  other-modules:
    O2I.Operation.Acquisition.Internal,
    O2I.Operation.Adapter.Internal,
    O2I.Operation.Diagnostic.AdapterOwner.Internal,
    O2I.Operation.Diagnostic.Internal,
    O2I.Operation.Diagnostic.Owner.Source.Internal,
    O2I.Operation.Discovery.Machine.Internal,
    O2I.Operation.Discovery.Profile.Internal,
    O2I.Operation.Discovery.Rule.Internal,
    O2I.Operation.Discovery.View.Internal,
    O2I.Operation.Encoding.Internal,
    O2I.Operation.Failure.Internal,
    O2I.Operation.Machine.Fragment.Internal,
    O2I.Operation.Machine.Internal,
    O2I.Operation.Preparation.Internal,
    O2I.Operation.Preparation.Runtime.Internal,
    O2I.Operation.Profile.Internal,
    O2I.Operation.Provenance.Internal,
    O2I.Operation.Request.Internal,
    O2I.Operation.Result.Internal,
    O2I.Operation.Rule.Generated,
    O2I.Operation.Rule.Internal.Catalog,
    O2I.Operation.Schema.Generated,
    O2I.Operation.Schema.Internal,
    O2I.Operation.View.Internal
  build-depends:
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11 && <0.12,
    o2i-archimate-profile ==0.3.0.0,
    o2i-core ==0.2.0.0,
    text >=2.1 && <2.2
  hs-source-dirs:
    src

test-suite o2i-operation-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.Operation.Acquisition,
    O2I.Operation.Acquisition.Internal,
    O2I.Operation.Adapter,
    O2I.Operation.Adapter.Authoring,
    O2I.Operation.Adapter.Internal,
    O2I.Operation.Discovery.Adapter,
    O2I.Operation.Discovery.Adapter.Machine,
    O2I.Operation.Discovery.Profile,
    O2I.Operation.Discovery.Profile.Internal,
    O2I.Operation.Discovery.Profile.Machine,
    O2I.Operation.Discovery.Rule,
    O2I.Operation.Discovery.Rule.Internal,
    O2I.Operation.Discovery.Rule.Explanation.Machine,
    O2I.Operation.Discovery.Rule.Inventory.Machine,
    O2I.Operation.Discovery.View,
    O2I.Operation.Discovery.View.Internal,
    O2I.Operation.Discovery.View.Machine,
    O2I.Operation.Diagnostic,
    O2I.Operation.Diagnostic.AdapterOwner.Internal,
    O2I.Operation.Diagnostic.Internal,
    O2I.Operation.Diagnostic.Owner,
    O2I.Operation.Diagnostic.Owner.Source,
    O2I.Operation.Diagnostic.Owner.Source.Internal,
    O2I.Operation.Discovery.Machine.Internal,
    O2I.Operation.Encoding.Internal,
    O2I.Operation.Failure,
    O2I.Operation.Failure.Internal,
    O2I.Operation.Machine,
    O2I.Operation.Machine.Fragment.Internal,
    O2I.Operation.Machine.Internal,
    O2I.Operation.Preparation,
    O2I.Operation.Preparation.Internal,
    O2I.Operation.Preparation.Runtime.Internal,
    O2I.Operation.Profile,
    O2I.Operation.Profile.Internal,
    O2I.Operation.Provenance,
    O2I.Operation.Provenance.Internal,
    O2I.Operation.Request,
    O2I.Operation.Request.Internal,
    O2I.Operation.Result.Internal,
    O2I.Operation.Rule.Catalog,
    O2I.Operation.Rule.Generated,
    O2I.Operation.Rule.Internal.Catalog,
    O2I.Operation.Schema,
    O2I.Operation.Schema.Generated,
    O2I.Operation.Schema.Internal,
    O2I.Operation.View,
    O2I.Operation.View.Internal,
    O2I.Operation.Test.Acquisition,
    O2I.Operation.Test.Adapter,
    O2I.Operation.Test.AdapterSupport,
    O2I.Operation.Test.Discovery,
    O2I.Operation.Test.DiscoveryMachine,
    O2I.Operation.Test.Diagnostic,
    O2I.Operation.Test.Encoding,
    O2I.Operation.Test.Failure,
    O2I.Operation.Test.Machine,
    O2I.Operation.Test.OwnerEvidence,
    O2I.Operation.Test.Preparation,
    O2I.Operation.Test.PreparationRuntime,
    O2I.Operation.Test.Profile,
    O2I.Operation.Test.Provenance,
    O2I.Operation.Test.Request,
    O2I.Operation.Test.Result,
    O2I.Operation.Test.RuleCatalog,
    O2I.Operation.Test.Schema,
    O2I.Operation.Test.View
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11 && <0.12,
    filepath >=1.4 && <1.6,
    jsonschema ==0.2.0.0,
    o2i-archimate-profile ==0.3.0.0,
    o2i-archimate-profile:conformance ==0.3.0.0,
    o2i-core ==0.2.0.0,
    o2i-core:conformance ==0.2.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    template-haskell >=2.22 && <2.23,
    text >=2.1 && <2.2
  hs-source-dirs:
    tst,
    src

test-suite o2i-operation-api-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ApiContractTH
  build-depends:
    base >=4.20 && <4.21,
    o2i-operation,
    template-haskell >=2.22 && <2.23
  hs-source-dirs:
    tst/api

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
