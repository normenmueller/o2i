cabal-version: 3.0

name: o2i-build-provenance
version: 0.2.0.0
synopsis: Revision-closed source provenance for O2I build artifacts.
category: Development
description:
  Embeds one exact Git source revision in O2I build artifacts and represents
  unavailable provenance explicitly.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Custom

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

custom-setup
  setup-depends:
    base >=4.18 && <4.19,
    Cabal >=3.10 && <3.11,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.5,
    process >=1.6 && <1.7

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.BuildProvenance
  autogen-modules:
    O2I.BuildProvenance.Generated
  other-modules:
    O2I.BuildProvenance.Generated
  build-depends:
    base >=4.18 && <4.19,
    text >=2.0 && <2.1
  hs-source-dirs:
    src

test-suite o2i-build-provenance-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base >=4.18 && <4.19,
    o2i-build-provenance,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.1
  hs-source-dirs:
    tst

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
