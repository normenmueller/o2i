cabal-version: 3.0

name: o2i-inspection
version: 0.2.0.0
synopsis: Format-neutral inspection flow for O2I models.
category: Formal Methods, Modelling
description:
  O2I Inspection acquires model input, executes a first-class notation adapter,
  closes a persisted semantic scope, runs the staged O2I validation pipeline,
  and produces deterministic reports with stable JSON serialization.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
extra-source-files:
  schema/o2i.command-error-v1.schema.json
  schema/o2i.inspection.report-v1.schema.json

flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.Inspection,
    O2I.Inspection.Adapter,
    O2I.Inspection.Cardinality,
    O2I.Inspection.Diagnostic,
    O2I.Inspection.Import,
    O2I.Inspection.Input,
    O2I.Inspection.Pipeline,
    O2I.Inspection.Profile,
    O2I.Inspection.Provenance,
    O2I.Inspection.Report,
    O2I.Inspection.Scope,
    O2I.Inspection.View
  other-modules:
    O2I.Inspection.Profile.Internal,
    O2I.Inspection.Report.Internal,
    O2I.Inspection.Scope.Internal
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <4.19,
    bytestring >=0.11 && <0.12,
    containers >=0.6 && <0.7,
    cryptohash-sha256 >=0.11 && <0.12,
    o2i-core ==0.2.0.0,
    text >=2.0 && <2.1,
    time >=1.12 && <1.13
  hs-source-dirs:
    src

test-suite o2i-inspection-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.18 && <4.19,
    bytestring >=0.11 && <0.12,
    containers >=0.6 && <0.7,
    filepath >=1.4 && <1.6,
    jsonschema ==0.2.0.0,
    o2i-core ==0.2.0.0,
    o2i-inspection,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.1,
    time >=1.12 && <1.13,
    vector >=0.13 && <0.14
  hs-source-dirs:
    tst

test-suite o2i-inspection-api-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ApiContractTH
  build-depends:
    base >=4.18 && <4.19,
    o2i-inspection,
    template-haskell >=2.20 && <2.21
  hs-source-dirs:
    tst/api

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
