  <folder name="Strategy" id="id-66b042ea434f45a3a9d80b8d7e938506" type="strategy"/>
  <folder name="Business" id="id-90c1a5486cd544c387110fb49b85c698" type="business"/>
  <folder name="Application" id="id-634f7306037f4eea9f7f38a9b4ff22aa" type="application"/>
  <folder name="Technology &amp; Physical" id="id-b0f42a85659e4e589190108d914575c0" type="technology"/>
  <folder name="Motivation" id="id-0d9ca5963b00432babfde51f34841c08" type="motivation">
    <folder name="Ethos" id="id-62a405d8516448199f793ca04d655b34">
      <element xsi:type="archimate:Principle" name="Disziplin" id="id-7b23fe89d265432eadf72d26a0408a49">
        <documentation>Wir arbeiten sorgfältig, halten Zusagen ein und verfolgen vereinbarte Vorhaben konsequent.</documentation>
        <property key="o2i.type" value="Principle"/>
        <property key="o2i.commitment" value="asserted"/>
      </element>
      <element xsi:type="archimate:Principle" name="Respekt" id="id-6e1906a073404a3f9ba7707e97b97c8f">
        <documentation>Wir nehmen die Menschen, ihre Anliegen und ihre Entscheidungsfreiheit ernst. Unterstützung bedeutet für uns, Menschen zu befähigen und ihre Verantwortung zu achten.</documentation>
        <property key="o2i.type" value="Principle"/>
        <property key="o2i.commitment" value="asserted"/>
      </element>
      <element xsi:type="archimate:Principle" name="Unabhängigkeit" id="id-808c774ec7d844cdbc0cdb44a50e3603">
        <documentation>Wir bilden unser Urteil anhand nachvollziehbarer Gründe. Empfehlungen sollen nicht durch sachfremde Interessen oder eine schon vorab bevorzugte Lösung bestimmt werden.</documentation>
        <property key="o2i.type" value="Principle"/>
        <property key="o2i.commitment" value="asserted"/>
      </element>
    </folder>
    <folder name="Mission" id="id-d3121bd91d154434a6a2a54bb6db3472">
      <element xsi:type="archimate:Driver" name="Entscheiden und Verwirklichen ermöglichen" id="id-0fb433979a1e4fd28a6eb0a7cd1aa87f">
        <documentation>Wir unterstützen Organisationen dabei, fundierte Entscheidungen zu treffen und ihre Vorhaben verlässlich umzusetzen.

Ein kleines Beispiel: Eine Kundin möchte die Bearbeitung ihrer Kundenanliegen verbessern. Wir hören den Beteiligten zu (**Respekt**), prüfen Ursachen und mögliche Lösungen ergebnisoffen (**Unabhängigkeit**) und begleiten die vereinbarten Veränderungen sorgfältig (**Disziplin**). Darin wird unser gewählter Beitrag als Unternehmen sichtbar: begründetes Entscheiden und verlässliches Umsetzen ermöglichen.</documentation>
        <property key="o2i.type" value="Driver"/>
        <property key="o2i.commitment" value="asserted"/>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-f62caa15c6f044288dc338e1d944c5d2" type="implementation_migration"/>
