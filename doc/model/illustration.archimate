    <element xsi:type="archimate:CompositionRelationship" name="contextualizes" id="id-9f4f614d3c894e9d9e4f2ddccfc31ff5" source="id-565c7313f81243d39dc77bd7a187507a" target="id-0fb433979a1e4fd28a6eb0a7cd1aa87f">
