    <element xsi:type="archimate:AssociationRelationship" name="guides" id="id-2876ddb68ec7415cb4f840f41d331e44" source="id-6e1906a073404a3f9ba7707e97b97c8f" target="id-0fb433979a1e4fd28a6eb0a7cd1aa87f" directed="true">
      <documentation>Bzgl. „Wir unterstützen Organisationen“: Respekt prägt unser Verständnis von Unterstützung: Wir nehmen die beteiligten Menschen ernst und achten ihre Entscheidungsverantwortung.</documentation>
      <property key="o2i.commitment" value="asserted"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="guides" id="id-aa5eb62304834e0e8cb17700c4465ba5" source="id-808c774ec7d844cdbc0cdb44a50e3603" target="id-0fb433979a1e4fd28a6eb0a7cd1aa87f" directed="true">
      <documentation>Bzgl. „fundierte Entscheidungen zu treffen“: Unabhängigkeit verlangt, Gründe und Alternativen offen zu prüfen. Die Empfehlung muss sich am Anliegen rechtfertigen lassen.</documentation>
      <property key="o2i.commitment" value="asserted"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="guides" id="id-f37903502edc4babaabd34a26501559d" source="id-7b23fe89d265432eadf72d26a0408a49" target="id-0fb433979a1e4fd28a6eb0a7cd1aa87f" directed="true">
      <documentation>Bzgl. „Vorhaben verlässlich umzusetzen“: Disziplin verlangt, aus Entscheidungen verbindliches Handeln werden zu lassen und Zusagen nachzuhalten.
</documentation>
      <property key="o2i.commitment" value="asserted"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="guides" id="id-a04d39c8f03b4e23b6901c78d2ccac8c" source="id-93cb6c87616d4153bb2edcc3dc11ce8c" target="id-565c7313f81243d39dc77bd7a187507a" directed="true">
      <property key="o2i.commitment" value="asserted"/>
    </element>
  </folder>
