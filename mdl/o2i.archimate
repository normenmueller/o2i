    <element xsi:type="archimate:InfluenceRelationship" name="contributes-to" id="id-c60b4f9674f84cc6b9e20ee7e4f5e27a" source="id-9ed8c8e1f3d84401bc683d94912faaa2" target="id-a374b154b8f24779944271015b8bda8a"/>
    <element xsi:type="archimate:InfluenceRelationship" name="substantiates" id="id-e797ab0de3cd49b6ba10e126e877cd87" source="id-a374b154b8f24779944271015b8bda8a" target="id-fb988118d1b248e9bc5a030715556aff">
      <documentation>Der überprüfbare Erfolgsbezug konkretisiert und stützt die strategische Absicht.</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" name="validates" id="id-a65bbdf7d61d486c861a1d1aa4f0c9b2" source="id-b831fd94030247b0b293e7aa344ffaa7" target="id-a374b154b8f24779944271015b8bda8a"/>
    <element xsi:type="archimate:AggregationRelationship" name="contains" id="id-6032c0b075804d52b798c4426ff37c20" source="id-2fb50ac1b2a3440695f860b0b1aed15c" target="id-5da5508c8e1b485bb632cee51bd6ff49"/>
    <element xsi:type="archimate:InfluenceRelationship" name="orients" id="id-634ae56c57dc4fc8b7c82581895c56c2" source="id-af45133ba69842bcbb3bda85551c3dda" target="id-af45133ba69842bcbb3bda85551c3dda"/>
    <element xsi:type="archimate:InfluenceRelationship" name="guides" id="id-62d54cc6c65044a68b194fd5463e2135" source="id-dee340198eb64cc48b52f8b42cb0c070" target="id-dee340198eb64cc48b52f8b42cb0c070">
      <documentation>Beispiel: Eine übergeordnete strategische Handlungslogik richtet die Guiding Policy einer untergeordneten Strategie aus.</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" name="contributes-to" id="id-9ec5843e571c408991576759f26110c2" source="id-8b8f82b28ed74a49b35a75b709c04e8c" target="id-8b8f82b28ed74a49b35a75b709c04e8c">
      <documentation>Diese Relation verbindet Erfolgsbezüge zwischen Strategien oder zwischen Intervention und Strategie. Die zulässige Lesart bestimmt jeweils der Kontext.</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" name="contributes-to" id="id-2cc3b753dffb488cafacbddd88b09942" source="id-cd9b992017fa4ebb84842d36185b63de" target="id-cd9b992017fa4ebb84842d36185b63de">
      <documentation>Diese Relation bildet einen Umsetzungsbeitrag zwischen strategischen Handlungsfestlegungen oder Interventionen ab. Sie begründet jedoch nicht Strategy --directs--> Strategy; dafür dient Principle --guides--> Principle.</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" name="guides" id="id-2eed9c51329c406ebfa6c928cef9e53a" source="id-cd9b992017fa4ebb84842d36185b63de" target="id-cd9b992017fa4ebb84842d36185b63de">
      <documentation>Beispiel: Action @ Strategy --guides--> Action @ Intervention. Dadurch wird Strategy --directs--> Intervention begründet.</documentation>
    </element>
