      <child xsi:type="archimate:DiagramObject" id="id-4f846b4b26284df2a7cb52107735547a" textPosition="1" archimateElement="id-21a6814e0787456d81c4fea06b5dc926">
        <bounds x="293" y="525" width="120" height="49"/>
        <feature name="deriveElementLineColor" value="false"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-1fdee101b1144655a2fbc5643f4a3b3d" source="id-4f846b4b26284df2a7cb52107735547a" target="id-dae31e0d08a64042a3f85220431549f2" archimateRelationship="id-f4b875c1f980437eb703b588b941523b"/>
