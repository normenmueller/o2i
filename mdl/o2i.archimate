      <child xsi:type="archimate:DiagramObject" id="id-dae31e0d08a64042a3f85220431549f2" targetConnections="id-1fdee101b1144655a2fbc5643f4a3b3d" textPosition="1" archimateElement="id-25f3ffe61f93476db90607538dad5b22">
        <bounds x="293" y="429" width="120" height="49"/>
        <feature name="deriveElementLineColor" value="false"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-4c1654be3470482f8b381660d12f2e5a" source="id-dae31e0d08a64042a3f85220431549f2" target="id-d79185a672874100a01b8a9e7dac9a4d" archimateRelationship="id-a4c98b99981e40968f2638423df0cc2b"/>
