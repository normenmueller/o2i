  <folder name="Implementation &amp; Migration" id="id-db81c99594df4e209210b0c681f98882" type="implementation_migration"/>
  <folder name="Other" id="id-b9bc8c62493d4d25bec1f06811abc961" type="other">
    <folder name="Semantic" id="id-75139bb41c94440792232df3eb901036">
      <folder name="Primitives" id="id-4a0bc2c8c6d54380ae65bc2a0c1cbd6f">
        <element xsi:type="archimate:Grouping" name="Principle" id="id-dee340198eb64cc48b52f8b42cb0c070">
          <documentation>O2I Primitive expressing a normative rule or decision criterion.

See o2i.md: Metamodell / Primitives.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Action" id="id-cd9b992017fa4ebb84842d36185b63de">
          <documentation>O2I Primitive expressing a deliberate commitment to act.

See o2i.md: Metamodell / Primitives.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Driver" id="id-ade8d7923089433c80c7fbac99dea59d">
          <documentation>O2I Primitive expressing an internal or external condition that motivates change.

See o2i.md: Metamodell / Primitives.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Objective" id="id-af45133ba69842bcbb3bda85551c3dda">
          <documentation>O2I Primitive expressing a qualitative desired state.

See o2i.md: Metamodell / Primitives.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Key Result" id="id-8b8f82b28ed74a49b35a75b709c04e8c">
          <documentation>O2I Primitive expressing a quantitative, verifiable result or target value.

See o2i.md: Metamodell / Primitives.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="KPI" id="id-b6d54675e24e4d3bb58d652fdfe5c493">
          <documentation>O2I Primitive defining a stable measurement for observing a fachlich determined condition.

See o2i.md: Metamodell / Primitives.</documentation>
        </element>
      </folder>
      <folder name="Contexts" id="id-84fa6bc6f5e44153b4fad79cf72c62e5">
        <folder name="Strategie" id="id-3e675a1f162a4c6ca3b14a7de61b67f5">
          <element xsi:type="archimate:Grouping" name="Strategy#Anchoring" id="id-371c94ba55e0431bad017fce7e754d23"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Coherent Action Commitments" id="id-9ed8c8e1f3d84401bc683d94912faaa2"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Derived Guardrails" id="id-51c1c18cf73d4bffb7b45469f3140798"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Diagnosis" id="id-3d983b35899d441582a8506e61445cb6"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Fit" id="id-b831fd94030247b0b293e7aa344ffaa7"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Guiding Policy" id="id-c60378e4ad23484aa92b698530dc705d"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Intent" id="id-fb988118d1b248e9bc5a030715556aff"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Positioning" id="id-f79c71fd74214caf80acec1ddb5426f0"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Scope" id="id-c746985283b74d8ea73daf99c6694a18"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Trade-offs" id="id-b6e09ac59a3e4024a90a6622cc799cc6"/>
          <element xsi:type="archimate:Grouping" name="Strategy#Success Reference" id="id-a374b154b8f24779944271015b8bda8a"/>
        </folder>
        <element xsi:type="archimate:Grouping" name="Situation" id="id-95420d4e66164023b79676213a6147e2">
          <documentation>O2I Context for a fachlich described work, performance, or environmental setting in which Needs become visible and assessable. It is constituted by one or more Situation anchors.

See o2i.md: Terminologie / Situierung / Situation.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Need" id="id-643791bdae8f4829a2151d7b658d84f1">
          <documentation>O2I Context for a solution-neutral, situated requirement for change. Strategy qualification makes the situated Need effect-relevant.

See o2i.md: Terminologie / Situierung / Bedarf.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Intervention" id="id-52230b6fa09b477fa7b7187f9bc03376">
          <documentation>Operational O2I Context for a deliberate change undertaking that addresses an effect-relevant Need and changes its Situation.

See o2i.md: Terminologie / Operationalisierung / Intervention.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Measure" id="id-a1eb98d8dd174918bb2a8adc88f87295">
          <documentation>O2I Context defining the fachlich measurement frame in which a relevant state or development of a Situation becomes observable.

See o2i.md: Terminologie / Wirkung / Messung.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Ethos" id="id-cf054314f7e944cea52ff8ec082377f8">
          <documentation>Cultural-normative O2I Context whose Principles define the standards by which goals, Strategies, and Actions are judged legitimate and coherent.

See o2i.md: Terminologie / Orientierung / Ethos.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Mission" id="id-209098a723f84d0787eab3cfed0e3db0">
          <documentation>Ethos-shaped O2I Context stating why a capable actor exists and which enduring contribution it makes.

See o2i.md: Terminologie / Orientierung / Mission.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Vision" id="id-63a27d11822d4ef4b45e65b0e7231fc4">
          <documentation>Ethos-shaped and Mission-grounded O2I Context stating the qualitative future state a capable actor seeks to realize.

See o2i.md: Terminologie / Orientierung / Vision.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Strategy" id="id-fc76733c15ce4d0fa08e1156adfa9879">
          <documentation>Vision-oriented O2I Context defining a grounded, coherent, and distinguishable path decision under given conditions.

See o2i.md: Terminologie / Formierung / Strategie.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Situation Anchor" id="id-29dc2a1c293a4400a24d39ff49739734">
          <documentation>Abstract, non-instantiable metamodel type for O2I Situation anchors. Its closed constructors are Business Capability, Business Process, Business Object, and Value Stream.

See o2i.md: Situierung and Metamodell / Situationsanker.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Context" id="id-f08503535a3a41fab16c720b556d5b59">
          <documentation>Abstract, non-instantiable O2I metamodel type whose closed constructors are Ethos, Mission, Vision, Strategy, Situation, Need, Intervention, and Measure.

See o2i.md: Metamodell / Kontexte.</documentation>
        </element>
      </folder>
      <folder name="Structuring" id="id-2dc6322906cd48dba3823d5edac1a680">
        <element xsi:type="archimate:Grouping" name="Performance Dimension" id="id-72043be07b814560a797a2dec8130315">
          <documentation>Abstract O2I structuring type for Strategy success dimensions and Measure measurement dimensions. It structures Key Results of its Strategy or KPIs of its Measure, respectively.

See o2i.md: Metamodell / Strukturierung.</documentation>
        </element>
      </folder>
      <folder name="Situation Anchors" id="id-9903846962b94d8a95521635649ce893">
        <element xsi:type="archimate:Grouping" name="Business Capability" id="id-4d37096102d147059a7d6068162d4e12">
          <documentation>O2I SituationAnchor constructor for an operational ability whose state or performance is the shared subject of Need, Intervention, and Measure.

See o2i.md: Metamodell / Situationsanker.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Business Process" id="id-447552868a1c4c189a4f01662956a2a4">
          <documentation>O2I SituationAnchor constructor for an operational behavior flow whose execution is the shared subject of Need, Intervention, and Measure.

See o2i.md: Metamodell / Situationsanker.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Business Object" id="id-f0902613c0e04fa3a30d441fa92eced3">
          <documentation>O2I SituationAnchor constructor for a business information object whose state is the shared subject of Need, Intervention, and Measure.

See o2i.md: Metamodell / Situationsanker.</documentation>
        </element>
        <element xsi:type="archimate:Grouping" name="Value Stream" id="id-c948442faaf04b4eb96c569e02a844e2">
          <documentation>O2I SituationAnchor constructor for an end-to-end value flow whose performance is the shared subject of Need, Intervention, and Measure.

See o2i.md: Metamodell / Situationsanker.</documentation>
        </element>
      </folder>
    </folder>
    <folder name="Syntax" id="id-528862f7ff2c456898f672cc0b1489b6">
      <folder name="Conformance" id="id-267c762f80ae4c6e9b835654ac1e8466">
        <documentation>Contains executable Candidate syntax exemplars for repository conformance Views. Exact contracts are defined by spc/ctr/archimate/profile.json.</documentation>
        <element xsi:type="archimate:Grouping" name="&lt;Contributor Strategy 1> :: O2I Strategy" id="id-a6fc406d20184ff98a2c46c3b9c90a6d">
          <property key="o2i.kind" value="Context"/>
          <property key="o2i.type" value="Strategy"/>
          <property key="o2i.commitment" value="candidate"/>
        </element>
        <element xsi:type="archimate:Grouping" name="&lt;Contributor Strategy 2> :: O2I Strategy" id="id-45f90e003d614d75bbdf2cd0ecb165bb">
          <property key="o2i.kind" value="Context"/>
          <property key="o2i.type" value="Strategy"/>
          <property key="o2i.commitment" value="candidate"/>
        </element>
        <element xsi:type="archimate:Grouping" name="&lt;Target Strategy> :: O2I Strategy" id="id-34f256a7a0c5484c9b6754e7bf4ba61c">
          <property key="o2i.kind" value="Context"/>
          <property key="o2i.type" value="Strategy"/>
          <property key="o2i.commitment" value="candidate"/>
        </element>
        <element xsi:type="archimate:Junction" name="&lt;Name> :: O2I Collective Strategy Realization" id="id-1e63836a9eb0426096a5eb96b4176788">
          <documentation>Candidate ArchiMate AND Junction carrier for one O2I CollectiveStrategyRealization StructuredProposition.

Contributor and target roles follow from realizes topology. Exact cardinality, Commitment, and collective Fit-evidence contracts are defined by spc/ctr/archimate/profile.json. This syntax exemplar is not a fachliche model instance.</documentation>
          <property key="o2i.kind" value="StructuredProposition"/>
          <property key="o2i.type" value="CollectiveStrategyRealization"/>
          <property key="o2i.commitment" value="candidate"/>
          <property key="o2i.collective-fit-evidence" value="&lt;Reference>"/>
        </element>
        <element xsi:type="archimate:Grouping" name="&lt;Name> :: O2I Mission" id="id-1cf38dc66c7f4a06800c8bf89dd7f476">
          <property key="o2i.kind" value="Context"/>
          <property key="o2i.type" value="Mission"/>
          <property key="o2i.commitment" value="candidate"/>
        </element>
        <element xsi:type="archimate:Grouping" name="&lt;Name> :: O2I Performance Dimension" id="id-5d86d1b167d045748a0605ab0cf5a08b">
          <property key="o2i.kind" value="Structuring"/>
          <property key="o2i.type" value="PerformanceDimension"/>
          <property key="o2i.commitment" value="candidate"/>
        </element>
        <element xsi:type="archimate:Grouping" name="&lt;Name> :: O2I Strategy" id="id-44063ecc73024c70827811bed992dd39">
          <property key="o2i.kind" value="Context"/>
          <property key="o2i.type" value="Strategy"/>
          <property key="o2i.commitment" value="candidate"/>
        </element>
      </folder>
      <element xsi:type="archimate:Grouping" name="ArchiMate Grouping" id="id-334a9c218c8947bc935a4e9aefbb7692"/>
      <element xsi:type="archimate:Grouping" name="ArchiMate Grouping (source)" id="id-c8a94a0fdcfb4fda9395c77465b8b404"/>
      <element xsi:type="archimate:Grouping" name="ArchiMate Grouping (target)" id="id-405fac672c5d435686f2943c23cc7d6c"/>
    </folder>
    <folder name="Illustration" id="id-29aaa03a216c4ad18ad87fbfdfe96bd7">
      <folder name="Layered Cake" id="id-0ae0912d56934922b877dcdd0669f47d">
        <folder name="Ethos" id="id-7ad67b83b7c84a409c5e06edb32e08eb">
          <element xsi:type="archimate:Grouping" name="Discipline :: Principle" id="id-ab5a8fc3167e451b8faa07efea8cdd1d">
            <documentation>Anspruch an Verlässlichkeit, Konsequenz, Ausführung.</documentation>
          </element>
          <element xsi:type="archimate:Grouping" name="Independence :: Principle" id="id-c328327ed26b4a5089b8274e62a2b15d">
            <documentation>eigenständig urteilen und handeln; eigenständiges Urteil, nicht opportunistisch/getrieben.</documentation>
          </element>
          <element xsi:type="archimate:Grouping" name="Respect :: Principle" id="id-1ec4121bd2874e6f8468f24da5ca2abc">
            <documentation>normativer Umgang mit Menschen/Stakeholdern.</documentation>
          </element>
          <element xsi:type="archimate:Grouping" name="Ethos" id="id-fc2d86c3ce2246a691f984b242fd5967"/>
        </folder>
        <folder name="Intervention" id="id-4dbb370cde4842259a956c1115cfad60">
          <element xsi:type="archimate:Grouping" name="Intervention" id="id-4acbcc80ba3c45c9843501b1fcc0bc0f"/>
          <element xsi:type="archimate:Grouping" name="Establish shared decision evidence practice :: Action" id="id-cfbe1f3d0231484da796e310ff68f694"/>
          <element xsi:type="archimate:Grouping" name="70% of relevant decisions are captured as shared decision records :: Key Result" id="id-e6d92afb406c4d97bddc6d0210821df8"/>
        </folder>
        <folder name="Measure" id="id-29102b81c48544f0aa876974bb92bfdb">
          <element xsi:type="archimate:Grouping" name="Measure" id="id-26cecad3e94b4123a9669f7530fc666e"/>
          <element xsi:type="archimate:Grouping" name="Shared decision traceability :: Performance Dimension" id="id-3b98d0546b914dd0ab9962dcc1d1bf8b">
            <documentation>Lesart: Die Messdimension ordnet die gemeinsame Nachvollziehbarkeit von Entscheidungen und bündelt die dafür verwendeten KPIs.</documentation>
          </element>
          <element xsi:type="archimate:Grouping" name="Shared decision traceability rate :: KPI" id="id-3cb2a51bf9b84a5796a8b6134aec7068">
            <documentation>Stabile Messdefinition, die beobachtbar macht, welcher Anteil relevanter Entscheidungen auf einen gemeinsamen Entscheidungsnachweis referenziert.</documentation>
          </element>
        </folder>
        <folder name="Mission" id="id-2d8075f35f43407f87f46b0a6b5523e8">
          <element xsi:type="archimate:Grouping" name="#hggt :: Driver" id="id-8b33d3d5d316422999552ebb78e7defb">
            <documentation>honest good time together</documentation>
          </element>
          <element xsi:type="archimate:Grouping" name="Mission" id="id-b72a61b51dea450894068f77a589d87d"/>
        </folder>
        <folder name="Need" id="id-2942dd21bcf94ef5baedda80ddcf763c">
          <element xsi:type="archimate:Grouping" name="Need" id="id-bc7f441fc807449d89107d25a9722b05"/>
          <element xsi:type="archimate:Grouping" name="Unshared and untraceable decisions create action uncertainty :: Driver" id="id-c36db08b115646b497521aa21615dcfc"/>
          <element xsi:type="archimate:Grouping" name="Increase traceable decisions :: Objective" id="id-a8f9ea0933b14bad951f6b32e24ae659"/>
          <element xsi:type="archimate:Grouping" name="Increase shared decision traceability :: Objective" id="id-ec87d3d4a2b6460ca485b41dbc93f08b"/>
        </folder>
        <folder name="Situation" id="id-3a60c765adbb40c9908783836b1d24d2">
          <element xsi:type="archimate:Grouping" name="Situation" id="id-8c348250cde04e30aa63e18b79a51ccd"/>
          <element xsi:type="archimate:Grouping" name="Information Management :: Business Capability" id="id-4e17e5ec1696437f837e2ef7ae35ced1">
            <documentation>Information Management umfasst das Sammeln, Organisieren, Verteilen und Sichern von Informationen sowie die Bereitstellung von Werkzeugen, Richtlinien und Prozessen für Informationsnutzung, Archivierung und Pflichtkommunikation.</documentation>
          </element>
        </folder>
        <folder name="Strategies" id="id-04cdb41ef7634fb285a2a28b319d9b4a">
          <folder name="Shared understanding" id="id-f73fc16d8e68446583d4fc338c09858a">
            <element xsi:type="archimate:Grouping" name="Fragmented understanding blocks confident action :: Driver" id="id-51e956c289a5471498ec676c382d1dcb">
              <documentation>strategische Herausforderung / Diagnosegrund</documentation>
            </element>
            <element xsi:type="archimate:Grouping" name="Make shared understanding actionable :: Objective" id="id-b6b7316e5f2d472f82cb6360db59077a">
              <documentation>strategische Absicht / angestrebter Beitrag</documentation>
            </element>
            <element xsi:type="archimate:Grouping" name="Shared decision evidence use :: Performance Dimension" id="id-2fb50ac1b2a3440695f860b0b1aed15c">
              <documentation>Lesart: Die strategische Erfolgsdimension ordnet den Einsatz gemeinsamer Entscheidungsnachweise.</documentation>
            </element>
            <element xsi:type="archimate:Grouping" name="80% of decisions reference shared decision records :: Key Result" id="id-5da5508c8e1b485bb632cee51bd6ff49">
              <documentation>strategischer Erfolgsnachweis</documentation>
            </element>
            <element xsi:type="archimate:Grouping" name="Create shared decision records :: Action" id="id-c80c65d1f98149c8aa25bc7dd2bbcada">
              <documentation>kohärente strategische Handlungsfestlegung</documentation>
            </element>
            <element xsi:type="archimate:Grouping" name="Act from evidence, not assumptions :: Principle" id="id-beb3184c33554858935c51ea8959567c">
              <documentation>Guiding Policy, Trade-offs, Entscheidungslogik</documentation>
            </element>
            <element xsi:type="archimate:Grouping" name="Shared understanding :: Strategy" id="id-a9ce771c416e45ab8cfb450e032817c0">
              <documentation>hggt Strategie oder Shared understanding strategy</documentation>
            </element>
          </folder>
          <folder name="Organizational transparency" id="id-a78f81eeffa845ed87415030c7630cb4">
