        <child xsi:type="archimate:DiagramObject" id="id-c84c68074fe0446ebe7bfb5c49191e82" textPosition="1" archimateElement="id-21a6814e0787456d81c4fea06b5dc926">
          <bounds x="293" y="525" width="120" height="49"/>
          <feature name="deriveElementLineColor" value="false"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-9adb0ecfc18b43b19a4323e06745eb14" source="id-c84c68074fe0446ebe7bfb5c49191e82" target="id-2ee769aa1b204ca3a971fb4d2d68f0ab" archimateRelationship="id-f4b875c1f980437eb703b588b941523b"/>
