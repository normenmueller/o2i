  <folder name="Implementation &amp; Migration" id="id-db81c99594df4e209210b0c681f98882" type="implementation_migration">
    <element xsi:type="archimate:WorkPackage" name="Work Package" id="id-21a6814e0787456d81c4fea06b5dc926"/>
    <element xsi:type="archimate:Gap" name="Gap" id="id-bba1ab1a01c0490e837d3136139c9cc7">
      <documentation>Gap ist in ArchiMate eigentlich eine Differenz zwischen Plateaus/Baseline-Target-Architekturen. Dieser &quot;Gap&quot; hier ist enger: Differenz zwischen KPI-Istwert und KR-Zielwert, oder allgemeiner:

> Gap = Differenz zwischen beobachtetem Zustand und angestrebtem Zielwert.

Ein Gap kann auf jeder Ebene entstehen: Bedarfs-Gap, strategischer Gap, Umsetzungs-/Performance-Gap</documentation>
    </element>
  </folder>
