{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "o2i.discovery.adapter-inventory/v1",
  "title": "Compiled adapter inventory",
  "oneOf": [
    {
      "$ref": "#/$defs/adapterInventory"
    }
  ],
  "$defs": {
    "adapterDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "notation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "notation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapterInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "authority",
        "adapters"
      ],
      "properties": {
        "schema": {
          "const": "o2i.discovery.adapter-inventory/v1"
        },
        "kind": {
          "const": "adapter-inventory"
        },
        "authority": {
          "const": "Operation"
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adapterDescriptor"
          },
          "minItems": 1
        }
      }
    }
  }
}
