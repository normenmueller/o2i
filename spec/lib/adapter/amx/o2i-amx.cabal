cabal-version: 3.0

name: o2i-amx
version: 0.3.0.0
synopsis: Native Archi Model XML adapter for O2I operations.
category: Formal Methods, Modelling
description:
  O2I AMX recognizes one exact native Archi Model XML representation and
  projects every relevant source observation into the profile-neutral O2I
  Draft consumed by the operation pipeline.
license: Apache-2.0
license-file: LICENSE
author: Normen Mueller
maintainer: normen.mueller@gmail.com
build-type: Simple
data-files:
  tst/data/README.md
  tst/data/manifest.json
  tst/data/invalid/decode/*.archimate
  tst/data/valid/native/*.archimate
  tst/data/valid/orientation/*.archimate
flag werror
  description: Treat compiler warnings as errors during development.
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wincomplete-patterns
  if flag(werror)
    ghc-options:
      -Werror

common language
  default-language: Haskell2010

library
  import:
    warnings,
    language
  exposed-modules:
    O2I.Adapter.AMX
  other-modules:
    O2I.Adapter.AMX.Internal.Contract,
    O2I.Adapter.AMX.Internal.Draft,
    O2I.Adapter.AMX.Internal.Types,
    O2I.Adapter.AMX.Internal.XML,
    O2I.Adapter.AMX.Internal.XML.DTD,
    O2I.Adapter.AMX.Internal.XML.Lexical,
    O2I.Adapter.AMX.Internal.XML.Scan
  build-depends:
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    o2i-archimate-profile ==0.3.0.0,
    o2i-operation ==0.3.0.0,
    text >=2.1 && <2.2,
    xml-conduit >=1.10 && <1.11
  hs-source-dirs:
    src

test-suite o2i-amx-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    O2I.Adapter.AMX,
    O2I.Adapter.AMX.Internal.Contract,
    O2I.Adapter.AMX.Internal.Draft,
    O2I.Adapter.AMX.Internal.Types,
    O2I.Adapter.AMX.Internal.XML,
    O2I.Adapter.AMX.Internal.XML.DTD,
    O2I.Adapter.AMX.Internal.XML.Lexical,
    O2I.Adapter.AMX.Internal.XML.Scan,
    O2I.Adapter.AMX.Repository,
    O2I.Adapter.AMX.Test.Contract,
    O2I.Adapter.AMX.Test.Draft,
    O2I.Adapter.AMX.Test.Fixture,
    O2I.Adapter.AMX.Test.Repository,
    O2I.Adapter.AMX.Test.XML,
    Paths_o2i_amx
  autogen-modules:
    Paths_o2i_amx
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    cryptohash-sha256 >=0.11 && <0.12,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    o2i-amx,
    o2i-archimate-profile ==0.3.0.0,
    o2i-core ==0.2.0.0,
    o2i-operation ==0.3.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.1 && <2.2,
    xml-conduit >=1.10 && <1.11
  hs-source-dirs:
    tst,
    src

test-suite o2i-amx-api-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    ApiContractTH
  build-depends:
    base >=4.20 && <4.21,
    o2i-amx,
    o2i-operation ==0.3.0.0,
    template-haskell >=2.22 && <2.23
  hs-source-dirs:
    tst/api

test-suite o2i-amx-integration-test
  import:
    warnings,
    language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base >=4.20 && <4.21,
    bytestring >=0.12 && <0.13,
    o2i-amx,
    o2i-archimate-profile ==0.3.0.0,
    o2i-operation ==0.3.0.0
  hs-source-dirs:
    tst/integration

executable o2i-amx-repository-view-check
  import:
    warnings,
    language
  main-is: repository/Main.hs
  other-modules:
    O2I.Adapter.AMX.Repository
  build-depends:
    base >=4.20 && <4.21,
    o2i-amx,
    o2i-archimate-profile ==0.3.0.0,
    o2i-core ==0.2.0.0,
    o2i-operation ==0.3.0.0,
    text >=2.1 && <2.2
  hs-source-dirs:
    tst

source-repository head
  type: git
  location: https://github.com/normenmueller/o2i.git
